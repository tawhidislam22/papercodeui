generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
  MODERATOR
  AUTHOR
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String   @unique
  displayName     String   @default("")
  avatarUrl       String   @default("")
  bio             String   @default("")
  xp              Int      @default(0)
  streak          Int      @default(0)
  longestStreak   Int      @default(0)
  role            Role     @default(USER)
  lastActiveDate  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     Submission[]
  blogs           Blog[]
  comments        Comment[]
  xpEvents        XpEvent[]
  lessonCompletions LessonCompletion[]
  blogLikes       BlogLike[]
  bookmarks       Bookmark[]
  following       Follow[] @relation("Following")
  followers       Follow[] @relation("Followers")
}

model Language {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String   @default("")
  color       String   @default("#3B82F6")
  description String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  challenges  Challenge[]
  submissions Submission[]
}

model Lesson {
  id          String     @id @default(uuid())
  languageId  String
  title       String
  slug        String
  description String     @default("")
  content     String     @default("")
  difficulty  Difficulty @default(BEGINNER)
  xpReward    Int        @default(20)
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  language    Language   @relation(fields: [languageId], references: [id])
  challenges  Challenge[]
  completions LessonCompletion[]
}

model Challenge {
  id            String     @id @default(uuid())
  lessonId      String?
  languageId    String
  title         String
  description   String
  starterCode   String     @default("")
  expectedOutput String    @default("")
  hints         String[]   @default([])
  difficulty    Difficulty @default(BEGINNER)
  xpReward      Int        @default(50)
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())

  lesson        Lesson?    @relation(fields: [lessonId], references: [id])
  language      Language   @relation(fields: [languageId], references: [id])
  submissions   Submission[]
}

model Submission {
  id             String           @id @default(uuid())
  userId         String
  challengeId    String?
  languageId     String?
  originalImageUrl String         @default("")
  extractedCode  String           @default("")
  correctedCode  String           @default("")
  aiFeedback     String           @default("")
  aiExplanation  String           @default("")
  runOutput      String           @default("")
  score          Int              @default(0)
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id])
  challenge      Challenge?       @relation(fields: [challengeId], references: [id])
  language       Language?        @relation(fields: [languageId], references: [id])
}

model Blog {
  id            String    @id @default(uuid())
  authorId      String
  title         String
  slug          String    @unique
  excerpt       String    @default("")
  content       String    @default("")
  coverImageUrl String    @default("")
  tags          String[]  @default([])
  aiSummary     String    @default("")
  isPublished   Boolean   @default(false)
  views         Int       @default(0)
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  readingTime   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
  likes         BlogLike[]
  bookmarks     Bookmark[]
}

model BlogLike {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  createdAt DateTime @default(now())

  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  createdAt DateTime @default(now())

  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Followers", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model XpEvent {
  id         String   @id @default(uuid())
  userId     String
  eventType  String
  xpAmount   Int
  description String @default("")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model LessonCompletion {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}
