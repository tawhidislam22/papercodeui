generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  AUTHOR
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BlockType {
  THEORY
  MCQ
  CODING
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ReviewStatus {
  PENDING
  COMPLETE
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String   @default("ChangeMe#1")
  username        String   @unique
  displayName     String   @default("")
  avatarUrl       String   @default("")
  bio             String   @default("")
  xp              Int      @default(0)
  streak          Int      @default(0)
  longestStreak   Int      @default(0)
  role            Role     @default(USER)
  isVerified      Boolean  @default(false)
  otp             String?
  otpExpiresAt    DateTime?
  lastActiveDate  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     Submission[]
  blogs           Blog[]
  comments        Comment[]
  xpEvents        XpEvent[]
  lessonProgress  UserProgress[]
  xpHistory       XPHistory[]
  streakProfile   Streak?
  codeExecutions  CodeExecution[]
  aiReviews       AIReview[]
  blogLikes       BlogLike[]
  bookmarks       Bookmark[]
  following       Follow[] @relation("Following")
  followers       Follow[] @relation("Followers")
}

model Language {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String   @default("")
  color       String   @default("#3B82F6")
  description String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  challenges  Challenge[]
  submissions Submission[]
}

model Lesson {
  id          String     @id @default(uuid())
  languageId  String
  title       String
  slug        String     @unique
  description String     @default("")
  difficulty  Difficulty @default(BEGINNER)
  xpReward    Int        @default(100)
  estimatedMinutes Int   @default(60)
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  language    Language   @relation(fields: [languageId], references: [id])
  chapters    Chapter[]
  progress    UserProgress[]
  challenges  Challenge[]
  bookmarks   Bookmark[]
}

model Chapter {
  id          String     @id @default(uuid())
  lessonId    String
  title       String
  description String     @default("")
  sortOrder   Int        @default(0)
  estimatedMinutes Int   @default(8)
  xpReward    Int        @default(20)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lesson      Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  blocks      LessonBlock[]
  progress    UserProgress[]
  executions  CodeExecution[]
}

model LessonBlock {
  id          String    @id @default(uuid())
  chapterId   String
  type        BlockType
  sortOrder   Int       @default(0)
  title       String    @default("")
  // For Theory blocks, content holds the markdown
  content     String    @default("") 
  codeLanguage String   @default("")
  
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  mcq         MCQQuestion?
  coding      CodingChallenge?
}

model MCQQuestion {
  id            String      @id @default(uuid())
  blockId       String      @unique
  question      String
  options       String[]
  correctIndex  Int
  explanation   String      @default("")

  block         LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model CodingChallenge {
  id            String      @id @default(uuid())
  blockId       String      @unique
  question      String
  starterCode   String      @default("")
  expectedOutput String     @default("")
  language      String      @default("")
  hints         String[]    @default([])

  block         LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id              String   @id @default(uuid())
  userId          String
  lessonId        String
  chapterId       String
  isCompleted     Boolean  @default(false)
  currentBlockId  String?
  completedBlockIds String[] @default([])
  attempts        Int      @default(0)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Challenge {
  id            String     @id @default(uuid())
  lessonId      String?
  languageId    String
  title         String
  description   String
  starterCode   String     @default("")
  expectedOutput String    @default("")
  hints         String[]   @default([])
  difficulty    Difficulty @default(BEGINNER)
  xpReward      Int        @default(50)
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())

  lesson        Lesson?    @relation(fields: [lessonId], references: [id])
  language      Language   @relation(fields: [languageId], references: [id])
  submissions   Submission[]
}

model Submission {
  id             String           @id @default(uuid())
  userId         String
  challengeId    String?
  languageId     String?
  originalImageUrl String         @default("")
  extractedCode  String           @default("")
  correctedCode  String           @default("")
  aiFeedback     String           @default("")
  aiExplanation  String           @default("")
  runOutput      String           @default("")
  score          Int              @default(0)
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id])
  challenge      Challenge?       @relation(fields: [challengeId], references: [id])
  language       Language?        @relation(fields: [languageId], references: [id])
}

model Blog {
  id            String    @id @default(uuid())
  authorId      String
  title         String
  slug          String    @unique
  excerpt       String    @default("")
  content       String    @default("")
  coverImageUrl String    @default("")
  tags          String[]  @default([])
  aiSummary     String    @default("")
  isPublished   Boolean   @default(false)
  views         Int       @default(0)
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  readingTime   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
  likes         BlogLike[]
  bookmarks     Bookmark[]
}

model BlogLike {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  createdAt DateTime @default(now())

  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  blogId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id        String   @id @default(uuid())
  blogId    String?
  lessonId  String?
  userId    String
  createdAt DateTime @default(now())

  blog      Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([blogId, userId])
  @@unique([lessonId, userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Followers", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model XpEvent {
  id         String   @id @default(uuid())
  userId     String
  eventType  String
  xpAmount   Int
  description String @default("")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model XPHistory {
  id         String   @id @default(uuid())
  userId     String
  sourceType String
  sourceId   String?
  xpAmount   Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
}

model CodeExecution {
  id            String           @id @default(uuid())
  userId        String
  chapterId     String?
  language      String
  sourceCode    String
  stdin         String           @default("")
  stdout        String           @default("")
  stderr        String           @default("")
  compileOutput String           @default("")
  status        ExecutionStatus  @default(PENDING)
  durationMs    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id])
  chapter       Chapter?         @relation(fields: [chapterId], references: [id])
  review        AIReview?
}

model AIReview {
  id            String      @id @default(uuid())
  executionId   String      @unique
  userId        String
  status        ReviewStatus @default(PENDING)
  verdict       String      @default("")
  feedback      String      @default("")
  suggestions   String      @default("")
  createdAt     DateTime    @default(now())

  execution     CodeExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])
}

